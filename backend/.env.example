# App
NODE_ENV=development
PORT=3001

# JWT
JWT_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_refresh_in_production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Database
DB_USER=alma
DB_PASS=alma_dev_pass
DATABASE_URL=postgresql://alma:alma_dev_pass@localhost:5432/alma

# Redis
REDIS_PASS=redis_dev_pass
REDIS_URL=redis://:redis_dev_pass@localhost:6379

# Firebase (JSON credentials)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS
ALLOWED_ORIGINS=http://localhost:3000
